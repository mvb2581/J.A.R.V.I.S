# ============================================================
# JARVIS — configuração de ambiente
# Copie para .env e preencha. Nunca versione o .env.
# ============================================================

# Servidor local
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
JARVIS_LOG_LEVEL=INFO
# JARVIS_DATA_DIR=C:\caminho\para\dados

# Provedor e modelo padrão (podem ser alterados na interface)
JARVIS_DEFAULT_PROVIDER=deepseek
JARVIS_DEFAULT_MODEL=deepseek-chat

# Chaves de API — use apenas uma ou mais conforme o provedor
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
JARVIS_CUSTOM_API_KEY=

# Endpoints (raramente precisam ser alterados)
JARVIS_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
JARVIS_OPENAI_BASE_URL=https://api.openai.com/v1
JARVIS_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
JARVIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Contexto do modelo local em tokens (2.048–32.768)
JARVIS_OLLAMA_NUM_CTX=8192
JARVIS_CUSTOM_BASE_URL=

# Tempo máximo de uma chamada ao provedor (segundos)
JARVIS_REQUEST_TIMEOUT=120

# Origens permitidas em desenvolvimento (separadas por vírgula)
JARVIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Voz (também ajustável na interface)
JARVIS_VOICE_LANGUAGE=pt-BR
JARVIS_STT_ENGINE=google
JARVIS_TTS_ENGINE=sapi
JARVIS_WAKE_WORD=jarvis
